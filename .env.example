# ─────────────────────────────────────────────────────────────
# Refúgio — variáveis de ambiente
# Copie para .env.local e preencha com os valores do SEU projeto.
# Sem estas variáveis, o app roda em "modo demonstração":
# conteúdo público de exemplo, sem salvar dados pessoais.
# ─────────────────────────────────────────────────────────────

# URL pública do site (usada em SEO, sitemap, links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo usado para gerar hash (não reversível) do IP no limite de
# envios do formulário de feedback. Gere um valor aleatório longo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA use o prefixo NEXT_PUBLIC_ nesta variável.
RATE_LIMIT_SALT=

# E-mail oficial para assuntos de privacidade (LGPD). Exibido na Política de
# privacidade. Opcional: se vazio, a página indica o formulário de contato.
NEXT_PUBLIC_CONTACT_EMAIL=
